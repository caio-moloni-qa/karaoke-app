# Same values as apps/web/.env.local
WEB_BASE_URL=http://localhost:3000
WORKER_API_KEY=

# Optional
WORKER_ID=
POLL_INTERVAL_SECONDS=5

# Only set this if downloads start failing with "Sign in to confirm you're
# not a bot" — value is a browser name yt-dlp will pull cookies from
# (chrome, edge, firefox, ...). That browser must be fully closed while the
# worker runs a download, since yt-dlp needs to read its cookie DB.
YTDLP_COOKIES_FROM_BROWSER=
