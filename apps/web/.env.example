# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the local worker sends as a Bearer token when polling
# app/api/worker/** (introduced in MVP2). Generate any long random string.
WORKER_API_KEY=

# Google Cloud Console -> YouTube Data API v3 (introduced in MVP2, needed for
# song search from the guest remote).
YOUTUBE_API_KEY=

# developer.spotify.com/dashboard -> Create app (Web API). Powers the
# Spotify song/album search in the import flow — public catalog only, no
# user login. Spotify requires the app owner to have Premium while the app
# is in development mode.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
